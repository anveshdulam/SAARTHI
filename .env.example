# SAARTHI Configuration Example
# Copy to .env and configure as needed.

# Security
INTERNAL_SECRET=change_this_to_a_random_32_byte_hex_string
SAARTHI_AUTH_TOKEN=demo-token

# Running Mode
DEMO_MODE=true

# Amazon Bedrock Settings
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6
# Optional AWS Credentials (if not using AWS CLI default profile or IAM role):
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Amazon Cognito Settings (Frontend & Backend JWT verification)
# VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM Execution Core Gateway (Optional API adapter)
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.5-flash-lite

